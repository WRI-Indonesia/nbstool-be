<PDFComposition>
    <Metadata>
        <Author>SCeNe Coalition</Author>
        <XMP>
            &lt;?xpacket begin='' id='scene-coalition'?&gt;
            &lt;x:xmpmeta xmlns:x='adobe:ns:meta/' x:xmptk='Image::ExifTool 7.89'&gt;
            &lt;rdf:RDF xmlns:rdf='http://www.w3.org/1999/02/22-rdf-syntax-ns#'&gt;
            &lt;/rdf:RDF&gt;
            &lt;/x:xmpmeta&gt;
            &lt;?xpacket end='w'?&gt;
        </XMP>
    </Metadata>

    <Javascript>
        button = app.alert({{cMsg: 'This file was generated by SCeNe Coalition NbS Tool. Do you want to visit its website ?', cTitle: 'Question', nIcon:2, nType:2}});
        if (button == 4) app.launchURL('https://nbstool.scenecoalition.org/');
    </Javascript>

    <LayerTree>
        <Layer id="base" name="Basemap" initiallyVisible="true">
            <Layer id="basemap" name="Maps" initiallyVisible="true"/>
            <Layer id="inmap_attribution" name="Attributes" initiallyVisible="true"/>
            <Layer id="legend" name="Legends" initiallyVisible="true" />
        </Layer>
        <Layer id="layers" name="Layers" initiallyVisible="true">
            <Layer id="polygon" name="Drew Polygons" initiallyVisible="true"/>
            {layers_xml_layer}
        </Layer>
    </LayerTree>

    <Page>
        <DPI>300</DPI>
        <Width>{width}</Width>
        <Height>{height}</Height>

        <Georeferencing id="georeferenced">
            <SRS dataAxisToSRSAxisMapping="2,1">EPSG:4326</SRS>
            <BoundingBox x1="{geo_x1}" y1="{geo_y1}" x2="{geo_x2}" y2="{geo_y2}"/>
            <ControlPoint x="{geo_x1}"  y="{geo_y1}"  GeoY="{latitude_bawah}"  GeoX="{longitude_kiri}"/>
            <ControlPoint x="{geo_x1}"  y="{geo_y2}"  GeoY="{latitude_atas}"   GeoX="{longitude_kiri}"/>
            <ControlPoint x="{geo_x2}"  y="{geo_y1}"  GeoY="{latitude_bawah}"  GeoX="{longitude_kanan}"/>
            <ControlPoint x="{geo_x2}"  y="{geo_y2}"  GeoY="{latitude_atas}"   GeoX="{longitude_kanan}"/>
        </Georeferencing>

        <Content streamCompression="NONE">

            <IfLayerOn layerId="base">
                <IfLayerOn layerId="basemap">
                    <Raster dataset="{basemap_path}" x1="{geo_x1}" y1="{geo_y1}" x2="{geo_x2}" y2="{geo_y2}" />
                </IfLayerOn>
            </IfLayerOn>

            <IfLayerOn layerId="layers">

                {layers_xml_raster}

                <IfLayerOn layerId="polygon">
                    <Vector georeferencingId="georeferenced" dataset="{polygon_path}" layer="test"
                        ogrStyleString="PEN(c:#04473a,w:5pt)" >
                        <Blending function="HardLight" opacity="1"/>
                        <LogicalStructure/>
                    </Vector>
                    <VectorLabel georeferencingId="georeferenced" dataset="{polygon_path}" layer="test"/>
                </IfLayerOn>

            </IfLayerOn>
            
            <IfLayerOn layerId="base">
                <IfLayerOn layerId="inmap_attribution">
                    <Raster dataset="{inmap_path}" x1="{geo_x1}" y1="{geo_y1}" x2="{geo_x2}" y2="{geo_y2}" />
                </IfLayerOn>
                <IfLayerOn layerId="legend">
                    <Raster dataset="{legend_path}" x1="{legend_x1}" y1="{legend_y1}" x2="{legend_x2}" y2="{legend_y2}" />
                </IfLayerOn>
            </IfLayerOn>

            <Raster dataset="{logo_path}" x1="{logo_x1}" y1="{logo_y1}" x2="{logo_x2}" y2="{logo_y2}" />

            <VectorLabel dataset="{labels_path}" layer="labels" />

        </Content>
    </Page>
</PDFComposition>